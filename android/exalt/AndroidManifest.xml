<!-- ExaltDS: the Zakuroishi app built as its own package for Fire Emblem Awakening (classes stay in io.github.zakuro.android,
     so the native bridge's JNI names are shared). The launcher starts straight into the game; the sidebar holds the rest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.exaltds" android:versionCode="2" android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <!-- update checks against GitHub and opt-in diagnostics; installing an update the player accepted -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00403000" android:required="true" />
    <application android:label="ExaltDS" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:extractNativeLibs="true" android:isGame="true" android:theme="@style/Theme.ExaltDS" android:hasCode="true">
        <profileable android:shell="true" />
        <activity android:name="io.github.zakuro.android.ExaltHome" android:exported="true" android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="io.github.zakuro.android.SavesProvider" android:authorities="io.github.exaltds.saves" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <receiver android:name="io.github.zakuro.android.DebugSettings" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="io.github.zakuro.android.Game" android:exported="false" android:launchMode="singleTask" android:process=":game" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" >
            <meta-data android:name="android.app.lib_name" android:value="zakuro_android" />
        </activity>
    </application>
</manifest>
